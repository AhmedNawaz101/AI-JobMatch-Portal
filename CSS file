/* ========== Global Styles ========== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Arial', sans-serif;
}

body {
    background-image: url('https://tse1.mm.bing.net/th/id/OIP.rEtNb0zAuuZkDf22axPu5QHaC5?cb=iwp1&w=2560&h=1004&rs=1&pid=ImgDetMain'); /* Update the path to your image */
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

/* ========== Header Styles ========== */
.header {
    background-color: #2c3e50;
    color: white;
    padding: 15px 20px;
    text-align: center;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.header-title {
    margin: 0;
    font-size: 24px;
    font-weight: bold;
}

/* ========== Home Page Styles ========== */
.home-container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 80vh; /* Center content vertically */
    background-color: transparent; /* Ensure the container is transparent */
}

.content-box {
    background-color: white;
    padding: 30px;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    text-align: center;
    width: 400px;
}

.content-box h2 {
    margin-bottom: 20px;
    font-size: 20px;
    color: #333;
}

.content-box .btn {
    display: block;
    margin: 10px auto;
    padding: 10px 20px;
    font-size: 16px;
    background-color: #007bff;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
}

.content-box .btn:hover {
    background-color: #0056b3;
}

/* ========== Login/Registration Styles ========== */
.login-container {
    background-color: white;
    padding: 30px;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    width: 400px;
    text-align: center;
    margin: 50px auto; /* Add margin to separate from the header */
}

.login-heading {
    background-color: #007bff;
    color: white;
    padding: 10px;
    border-radius: 4px;
    margin-bottom: 20px;
    font-size: 20px;
}

form {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

form label {
    text-align: left;
    font-weight: bold;
    color: #555;
}

form input,
form select {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 14px;
}

form button {
    background-color: #007bff;
    color: white;
    border: none;
    padding: 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 16px;
}

form button:hover {
    background-color: #0056b3;
}

/* ========== Applicant Page Styles ========== */
.applicant-page .form-container {
    background-color: white;
    padding: 20px 30px;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    width: 400px;
    text-align: center;
    margin: 0 auto;
}

.applicant-page form {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.applicant-page form label {
    text-align: left;
    font-weight: bold;
    color: #555;
}

.applicant-page form input,
.applicant-page form textarea,
.applicant-page form select {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 14px;
}

.applicant-page form textarea {
    resize: none;
    height: 80px;
}

.applicant-page form button {
    background-color: #007bff;
    color: white;
    border: none;
    padding: 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 16px;
}

.applicant-page form button:hover {
    background-color: #0056b3;
}

/* ========== Job Listings Styles ========== */
.job-listings-container {
    margin: 20px auto;
    padding: 20px;
    background-color: #f9f9f9;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    width: 80%;
    text-align: center;
}

.job-box {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    background-color: white;
    padding: 15px;
    margin: 10px 0;
    border: 1px solid #ddd;
    border-radius: 8px;
    text-align: left;
    gap: 15px;
}

.job-box h3 {
    margin: 0 0 10px;
    color: #333;
}

.job-box p {
    margin: 5px 0;
    color: #555;
}

.job-box .btn {
    margin-top: 10px;
    margin-right: 10px;
    padding: 8px 12px;
    background-color: #007bff;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
}

.job-box .btn:hover {
    background-color: #0056b3;
}

.job-box .job-image {
    width: 150px;
    height: auto;
    border-radius: 8px;
    object-fit: cover;
}
.job-image {
    width: 100%;
    height: auto;
    border-radius: 8px;
    margin-bottom: 10px;
    object-fit: cover;
}
/* ========== Header Buttons ========== */
.header-buttons {
    display: flex;
    gap: 10px;
    margin-left: auto;
}

.header-buttons .btn {
    background-color: #007bff;
    color: white;
    border: none;
    padding: 8px 12px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
}

.header-buttons .btn:hover {
    background-color: #0056b3;
}

/* Messages Section Styles */
.messages-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background-color: #f9f9f9;
    min-height: 80vh; /* Ensure it takes up most of the viewport height */
}

#chatList {
    width: 100%;
    max-width: 600px;
    margin-bottom: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
}

.chat-list-btn {
    background-color: #007bff;
    color: white;
    border: none;
    padding: 10px 15px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
}

.chat-list-btn:hover {
    background-color: #0056b3;
}

#chatWindow {
    width: 100%;
    max-width: 600px;
    background-color: white;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

#chatEmployerName {
    margin: 0;
    font-size: 18px;
    font-weight: bold;
    color: #333;
    text-align: center;
}

.chat-messages {
    flex-grow: 1;
    overflow-y: auto;
    max-height: 300px;
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 10px;
    background-color: #f4f4f4;
}

.chat-messages p {
    margin: 5px 0;
    font-size: 14px;
    color: #333;
}

#chatInput {
    width: calc(100% - 80px);
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 14px;
}

#sendMessageBtn {
    background-color: #007bff;
    color: white;
    border: none;
    padding: 10px 15px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
}

#sendMessageBtn:hover {
    background-color: #0056b3;
}
