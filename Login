<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>
    <link rel="stylesheet" href="styles.css">
    <style>
        .debug-info {
            margin-top: 20px;
            padding: 10px;
            background-color: #f8f9fa;
            border-radius: 5px;
            font-family: monospace;
            font-size: 12px;
        }
    </style>
</head>
<body>
    <!-- Header Section -->
    <header class="header">
        <h1 class="header-title">AI JobPortal</h1>
    </header>

    <main>
        <div class="login-container">
            <h2 class="login-heading">Login Page</h2>
            <form id="loginForm">
                <label for="email">Email:</label>
                <input type="email" id="email" placeholder="Enter your email" required>

                <label for="password">Password:</label>
                <input type="password" id="password" placeholder="Enter your password" required>

                <label for="role">Role:</label>
                <select id="role" required>
                    <option value="" disabled selected>Select your role</option>
                    <option value="applicant">Job Seeker</option>
                    <option value="employer">Recruiter</option>
                    <option value="admin">Admin</option>
                </select>

                <button type="submit" class="btn">Login</button>
            </form>
            <div id="debugInfo" class="debug-info"></div>
        </div>
    </main>

    <script>
        // Handle login form submission
        document.getElementById('loginForm').addEventListener('submit', async (e) => {
            e.preventDefault();
        
            const email = document.getElementById('email').value.trim();
            const password = document.getElementById('password').value.trim();
            const role = document.getElementById('role').value.toLowerCase();
            
            const debugInfo = document.getElementById('debugInfo');
            debugInfo.innerHTML = `Attempting login with: ${email}, role: ${role}`;
        
            if (!email || !password || !role) {
                alert('Please fill in all fields.');
                return;
            }
        
            try {
                // Attempt login
                const response = await fetch('http://localhost:5000/api/users/login', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ 
                        email, 
                        password, 
                        role
                    })
                });

                // Check if response is JSON
                const contentType = response.headers.get('content-type');
                if (!contentType || !contentType.includes('application/json')) {
                    debugInfo.innerHTML += '<br>Error: Server did not return JSON. Status: ' + response.status;
                    throw new Error('Server error: Invalid response format');
                }
        
                const data = await response.json();
                debugInfo.innerHTML += '<br>Server response: ' + JSON.stringify(data);
                
                if (!response.ok) {
                    throw new Error(data.message || 'Login failed');
                }
        
                // Store user data
                localStorage.setItem('currentUser', JSON.stringify(data.data));
        
                // Redirect based on role
                const redirectMap = {
                    'applicant': 'index.html',
                    'employer': 'employer.html',
                    'admin': 'admin.html'
                };

                const redirectPage = redirectMap[data.data.role];
                if (redirectPage) {
                    window.location.href = redirectPage;
                } else {
                    throw new Error('Invalid role configuration');
                }
            } catch (error) {
                debugInfo.innerHTML += `<br>Error: ${error.message}`;
                alert('Login Error: ' + error.message);
            }
        });
    </script>
</body>
</html>
